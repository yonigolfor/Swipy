<?xml version="1.0" encoding="utf-8"?>
<!-- Sampled from the iOS AppIcon.png master (Swipy/Assets.xcassets/AppIcon.appiconset/AppIcon.png)
     corner pixels: darker navy at the bottom, lighter navy at the top — same vertical gradient
     direction as the source art, so the foreground layer's own baked-in background blends into
     this layer at the adaptive-icon mask edge instead of showing a visible seam. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#041235"
        android:endColor="#12305F"
        android:type="linear" />
</shape>
